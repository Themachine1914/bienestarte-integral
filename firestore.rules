rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Being signed in is not enough. Email/password signup is open on this
     * project — anyone with the web API key, which ships in the bundle, can
     * create an account — so `request.auth != null` let a stranger read the
     * patient records. Admin is an explicit grant: a document under /admins
     * named after the uid, writable only from the console or the Admin SDK.
     */
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The grant itself. An account may check its own, and nothing more: no
    // listing who the admins are, and no client can ever add one.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // An appointment's start as a real instant. `date` and `time` are wall
    // clock in practice time; the Dominican Republic is UTC-4 all year, with
    // no daylight saving, so the offset is a constant. Mirrors
    // appointmentStartUtc() in src/lib/policy.ts — change both together.
    function apptStartUtc(d, t) {
      return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]))
             + duration.value(int(t[0:2]), 'h')
             + duration.value(int(t[3:5]), 'm')
             + duration.value(4, 'h');
    }

    function outsideRescheduleWindow(d, t) {
      return request.time < apptStartUtc(d, t) - duration.value(24, 'h');
    }

    function minutesOf(t) {
      return int(t[0:2]) * 60 + int(t[3:5]);
    }

    function consecutiveTimes(times, hours, start) {
      return times.size() == hours
             && times[0] == start
             && (hours == 1
                 || (times.size() >= 2
                     && minutesOf(times[1]) == minutesOf(times[0]) + 60))
             && (hours < 3
                 || (times.size() >= 3
                     && minutesOf(times[2]) == minutesOf(times[0]) + 120));
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /availability/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fully closed. Patient records hold clinical notes, and the public
    // booking flow no longer touches them — the admin panel links each
    // appointment to a patient once she signs in.
    match /patients/{id} {
      allow read, write: if isAdmin();
    }

    // Booked times. The document id is `${date}_${time}`, which makes `create`
    // an atomic claim: two people submitting the same slot, only the first
    // succeeds.
    //
    // `read` has to stay public, and that means `list` too: the booking page
    // queries this collection by date to grey out taken times. So treat every
    // field here as world-readable. It once carried `appointmentId`, which was
    // the patient's lookup code — anyone could list the collection, harvest
    // every code, and `get` the matching appointment with its name, phone,
    // email and payment receipt. The lock now stores only when a slot is
    // taken, never whose it is.
    //
    // `hasOnly` enforces that: a write carrying any extra field is rejected,
    // so an identifier cannot be reintroduced by accident.
    match /slots/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'date', 'time', 'createdAt'])
                    && request.resource.data.keys().hasAll(['date', 'time'])
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && id == request.resource.data.date + '_' + request.resource.data.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /appointments/{reference} {
      // `get` but never `list`. The document id is the unguessable code shown
      // to the patient once, so they can open their own appointment and nobody
      // can walk the collection. Listing stays with the admin.
      allow get: if true;
      allow list: if isAdmin();

      allow create: if request.resource.data.keys().hasAll([
                         'reference', 'patientName', 'patientEmail', 'patientPhone',
                         'date', 'time', 'status', 'paymentProofUrl'
                       ])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reference == reference
                    && request.resource.data.get('hours', 1) in [1, 2, 3]
                    && request.resource.data.times is list
                    && consecutiveTimes(
                         request.resource.data.times,
                         request.resource.data.get('hours', 1),
                         request.resource.data.time
                       )
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && request.resource.data.price <= 20000;

      // A patient may move their own appointment and nothing else. The lookup
      // code is the only credential, so this is scoped as tightly as it can
      // be: which fields may change, that the status is untouched, that the
      // counter goes up by exactly one and stops at the cap, that the old
      // start is still more than 24 hours away, and that the new one is in
      // the future. Without the field allow-list, knowing a code would be
      // enough to set status to 'confirmed' and skip payment review.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['date', 'time', 'times', 'hours', 'updatedAt', 'rescheduleCount', 'previousSlots', 'reminderSentAt', 'attendanceConfirmedAt'])
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == resource.data.status
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.hours == resource.data.get('hours', 1)
        && request.resource.data.times is list
        && consecutiveTimes(
             request.resource.data.times,
             request.resource.data.hours,
             request.resource.data.time
           )
        && request.resource.data.rescheduleCount == resource.data.get('rescheduleCount', 0) + 1
        && request.resource.data.rescheduleCount <= 2
        && request.resource.data.previousSlots.size() <= 2
        && outsideRescheduleWindow(resource.data.date, resource.data.time)
        && apptStartUtc(request.resource.data.date, request.resource.data.time) > request.time
      ) || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendanceConfirmedAt', 'updatedAt'])
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.attendanceConfirmedAt is string
      ) || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['invoice', 'updatedAt'])
        && resource.data.status in ['pending', 'confirmed', 'completed']
        && !('invoice' in resource.data)
        && request.resource.data.invoice.keys().hasOnly(['requestedAt', 'legalName', 'rncCedula', 'email'])
        && request.resource.data.invoice.keys().hasAll(['requestedAt', 'legalName', 'rncCedula', 'email'])
        && request.resource.data.invoice.legalName is string
        && request.resource.data.invoice.legalName.size() >= 2
        && request.resource.data.invoice.legalName.size() < 120
        && request.resource.data.invoice.rncCedula is string
        && request.resource.data.invoice.rncCedula.size() < 30
        && request.resource.data.invoice.email is string
        && request.resource.data.invoice.email.size() < 80
        && request.resource.data.invoice.requestedAt is string
      );

      allow delete: if isAdmin();
    }

    // Written by the public booking flow, so `create` cannot require auth.
    // The dashboard renders these messages as her feed of what happened, which
    // makes an unconstrained create a way to put words on her screen — so a
    // notification has to look like one the app would write, and has to point
    // at an appointment that exists. Someone holding a real lookup code can
    // still forge one; someone holding nothing cannot.
    match /notifications/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['type', 'appointmentId', 'message', 'read', 'createdAt'])
                    && request.resource.data.type in [
                         'appointment_created', 'appointment_confirmed',
                         'appointment_rejected', 'appointment_cancelled',
                         'appointment_rescheduled', 'appointment_reminder']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 300
                    && request.resource.data.read == false
                    && exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId));
      allow read, update, delete: if isAdmin();
    }

    // Written only by /api/push with the Admin SDK. Clients must not list
    // endpoints — they are enough to send spam to a phone.
    match /pushSubscriptions/{id} {
      allow read, write: if false;
    }
  }
}
