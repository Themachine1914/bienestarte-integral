rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /payment-proofs/{fileName} {
      // getDownloadURL() needs `get` for the unauthenticated patient who just
      // uploaded. `list` stays admin-only so nobody can walk every receipt.
      // The download URL still carries its own token.
      allow get: if true;
      // Nothing in the app walks this bucket, and `request.auth != null` was
      // not a real gate: anyone can self-register. Closed outright — receipts
      // are reached through the URL stored on each appointment.
      allow list: if false;

      // Anonymous create is required: patients upload a receipt before there
      // is any account. Bounded by size and type, and write-once so an
      // existing proof can never be swapped out or deleted from the client.
      allow create: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
