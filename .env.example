# Firebase — create a project at https://console.firebase.google.com
# Enable Authentication (Email/Password), Firestore, and Storage.
# Without these values the app runs in local demo mode (localStorage).

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Optional: demo admin credentials when Firebase is not configured
VITE_DEMO_ADMIN_EMAIL=admin@bienestarteintegral.com
VITE_DEMO_ADMIN_PASSWORD=bienestarte2026

# Optional. Branded password-reset email from /api/reset-password.
# Without this, Firebase still sends its own email (in Spanish).
# Verify the domain in Resend or use their onboarding sender.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Bienestarte Integral <noreply@bienestarteintegral.com>

# Server-only (Vercel). Used by /api/reminders — never prefix with VITE_.
# Daily cron at 08:00 AST sends a WhatsApp reminder for tomorrow's sessions.
CRON_SECRET=YOUR_CRON_SECRET
SITE_URL=https://YOUR_DOMAIN
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID"}
WHATSAPP_TOKEN=YOUR_WHATSAPP_CLOUD_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
# Proactive WhatsApp needs an approved template (plain text fails outside 24h).
# Test WABA: hello_world / en_US. Later: cita_recordatorio / es
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US

# Web Push (phone alerts while the app is closed). Generate with:
# npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_EMAIL
